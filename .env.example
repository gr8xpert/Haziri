APP_NAME=Hazri
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hazri.localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Hazri ---------------------------------------------------------------
# shared = many tenants on *.HAZRI_CENTRAL_DOMAIN; dedicated = single tenant on its own server (spec §3.2)
HAZRI_MODE=shared
HAZRI_DEDICATED_TENANT=
HAZRI_CENTRAL_DOMAIN=hazri.localhost
HAZRI_ADMIN_DOMAIN=admin.hazri.localhost
HAZRI_ADMS_DOMAIN=adms.hazri.localhost
HAZRI_API_DOMAIN=api.hazri.localhost

# Central DB. The user needs CREATE DATABASE rights: tenant DBs are hazri_t_{slug}.
DB_CONNECTION=central
DB_DRIVER=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hazri_central
DB_USERNAME=hazri
DB_PASSWORD=hazri

# Read-only DB user for "Ask Hazri" AI queries (spec §12)
AI_DB_READONLY_USERNAME=
AI_DB_READONLY_PASSWORD=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

WHATSAPP_PROVIDER=log
SMS_PROVIDER=log
# -------------------------------------------------------------------------

# File sessions/cache: no Redis on Plesk. Sessions are per host (each tenant subdomain has its own cookie).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hazri.localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
